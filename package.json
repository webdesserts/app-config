{
  "name": "@webdesserts/app-config",
  "version": "0.1.0",
  "description": "XDG base-directory resolution and symlink-preserving atomic config I/O for webdesserts apps",
  "license": "Apache-2.0",
  "author": "Michael Mullins",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webdesserts/app-config.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=2 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "typescript": "5.9.3"
  }
}
